# Application
APP_ENV=development
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://rumah-kosim.rhankbrguw.xyz

# Database (MySQL / TiDB Serverless)
# Local: mysql://root:password@localhost:3306/rumah_kosim
# Prod : mysql://<user>:<password>@<tidb-host>:4000/rumah_kosim?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://user:password@localhost:3306/rumah_kosim"

# Security & Authentication (JWT)
JWT_SECRET="your_secure_jwt_secret_min_32_characters"

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY="your_midtrans_server_key"
PUBLIC_MIDTRANS_CLIENT_KEY="your_midtrans_client_key"
MIDTRANS_IS_PRODUCTION="false"

# Resend Configuration
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM="noreply@rhankbrguw.xyz"
RESEND_FROM_NAME="Rumah Kosim"

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Redis Cache (Upstash)
REDIS_REST_URL=""
REDIS_REST_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
